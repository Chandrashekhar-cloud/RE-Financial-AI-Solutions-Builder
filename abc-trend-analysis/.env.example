# ==============================================================================
# QuickBooks Sandbox & Analysis Environment Configuration Example
# Copy this file to .env and populate with your Intuit Developer Sandbox credentials.
# NEVER commit real credentials, secrets, or refresh tokens to source control.
# ==============================================================================

# Intuit Developer OAuth 2.0 Credentials (Sandbox)
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=http://localhost:8000/callback
QUICKBOOKS_ENVIRONMENT=sandbox
QUICKBOOKS_REALM_ID=
QUICKBOOKS_REFRESH_TOKEN=

# Safety & Restriction Flags (Enforce Read-Only Mode)
# In read-only mode, mutation tools (create, update, delete) are suppressed/blocked.
QUICKBOOKS_DISABLE_WRITE=true
QUICKBOOKS_DISABLE_UPDATE=true
QUICKBOOKS_DISABLE_DELETE=true

# Alternative Safety Flags
QUICKBOOKS_ALLOW_CREATE=false
QUICKBOOKS_ALLOW_UPDATE=false
QUICKBOOKS_ALLOW_DELETE=false

# Analysis Pipeline Settings
ANALYSIS_PRECISION_CENTS=0.01

# ==============================================================================
# LLM Financial Analysis & Review Configuration (Optional)
# Configure either Anthropic or OpenRouter to run automated LLM reviews.
# NEVER commit real credentials, API keys, or tokens to version control.
# ==============================================================================
# Anthropic Provider
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# OpenRouter Provider (uses Anthropic-compatible endpoint: https://openrouter.ai/api)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# OPENROUTER_BASE_URL=https://openrouter.ai/api

